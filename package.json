{
  "name": "nestegg-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "A retirement-savings demo app in React Native: biometric sign-in, real-time balances, contribution planning, and a plan-admin view.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "expo": "~52.0.11",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.1",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@testing-library/react-native": "12.8.1",
    "@types/jest": "29.5.14",
    "@types/react": "~18.3.12",
    "jest": "29.7.0",
    "jest-expo": "~52.0.2",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@tanstack/.*)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ]
  },
  "license": "MIT"
}
